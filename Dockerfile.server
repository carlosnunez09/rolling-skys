FROM ubuntu:22.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libasound2 \
        libdbus-1-3 \
        libgcc-s1 \
        libglib2.0-0 \
        libpulse0 \
        libstdc++6 \
        libudev1 \
        libx11-6 \
        libxcursor1 \
        libxi6 \
        libxinerama1 \
        libxrandr2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY deploy/docker-context/app/ /app/
RUN chmod +x /app/entrypoint.sh

EXPOSE 7777/udp
ENTRYPOINT ["/app/entrypoint.sh"]
